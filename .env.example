# Pravaah environment variables.
# Copy to .env.local (git-ignored) for local development, and set the same names in your host's
# environment settings for deployment. Keys are read by the server only and never reach the browser.

# One or more Groq keys, comma separated. Requests rotate through them (round robin) and any key
# that hits a rate limit is rested while the others carry on. Groq limits apply per organisation,
# so keys from different accounts add capacity; keys from one account share it.
GROQ_API_KEYS=

# One or more Sarvam keys, comma separated (translation, speech to text, text to speech).
SARVAM_API_KEYS=

# Optional model overrides.
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

VITE_APP_ENV=development
VITE_BASE_PATH=/
